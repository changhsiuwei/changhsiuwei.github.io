{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hw-chang-site-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "kv_namespaces": [
    {
      "binding": "VIEWS_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "changhsiuwei",
    "GITHUB_REPO": "changhsiuwei.github.io",
    "GITHUB_BRANCH": "main",
    "CF_ACCESS_TEAM_DOMAIN": "YOUR_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "YOUR_ACCESS_APPLICATION_AUD",
    "ALLOWED_EMAIL": "YOUR_ADMIN_EMAIL",
    "ALLOWED_ORIGINS": "chrome-extension://YOUR_EXTENSION_ID,https://your-domain.com,http://localhost:8787"
  }
}
